install.packages("shiny")
library(shiny)
ui <- fluidPage(
titlePanel("Esempio di Shiny"),
sidebarLayout(
sidebarPanel(
sliderInput("num", "Scegli un numero:", min = 1, max = 100, value = 50)
),
mainPanel(
textOutput("result")
)
)
)
server <- function(input, output) {
output$result <- renderText({
paste("Hai scelto il numero:", input$num)
})
}
shinyApp(ui = ui, server = server)
ui <- fluidPage(
titlePanel("La mia web app"),
sidebarLayout(
sidebarPanel(
sliderInput("num", "Scegli un numero:", min = 1, max = 100, value = 50)
),
mainPanel(
textOutput("result")
)
)
)
server <- function(input, output) {
output$result <- renderText({
paste("Hai scelto il numero:", input$num)
})
}
shinyApp(ui = ui, server = server)
