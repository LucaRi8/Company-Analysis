apply(EQUI3, 2, mean),
apply(EQUI4, 2, mean))
colnames(EQUI) <- c("0.99", "0.95", "0.9")
# frequentisti
MPL1 <- do.call(rbind, lapply(Ber_freq1, function(l) if(sum(is.na(l[[1]]$MPL_99))==0) {
c(between(0, l[[1]]$MPL_99[1, 2], l[[1]]$MPL_99[2, 2]),
between(0, l[[1]]$MPL_95[1, 2], l[[1]]$MPL_95[2, 2]),
