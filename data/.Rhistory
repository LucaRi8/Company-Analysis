#Copertura intervalli sigma^2_12 (covarianza tra intercetta e pendenza casuale)
HPD1 <- do.call(rbind, lapply(Ber_s1, function(l)
c(between(0, l$hpd99[1, 3], l$hpd99[2, 3]),
between(0, l$hpd95[1, 3], l$hpd95[2, 3]),
between(0, l$hpd90[1, 3], l$hpd90[2, 3]))))
HPD2 <- do.call(rbind, lapply(Ber_s2, function(l)
c(between(0, l$hpd99[1, 3], l$hpd99[2, 3]),
between(0, l$hpd95[1, 3], l$hpd95[2, 3]),
between(0, l$hpd90[1, 3], l$hpd90[2, 3]))))
HPD3 <- do.call(rbind, lapply(Ber_s3, function(l)
c(between(0, l$hpd99[1, 3], l$hpd99[2, 3]),
between(0, l$hpd95[1, 3], l$hpd95[2, 3]),
between(0, l$hpd90[1, 3], l$hpd90[2, 3]))))
HPD4 <- do.call(rbind, lapply(Ber_s4, function(l)
c(between(0.25, l$hpd99[1, 3], l$hpd99[2, 3]),
between(0.25, l$hpd95[1, 3], l$hpd95[2, 3]),
between(0.25, l$hpd90[1, 3], l$hpd90[2, 3]))))
HPD <-rbind(apply(HPD1, 2, mean),
apply(HPD2, 2, mean),
apply(HPD3, 2, mean),
apply(HPD3, 2, mean))
colnames(HPD) <- c("99%", "95%", "90%")
EQUI1 <- do.call(rbind, lapply(Ber_s1, function(l)
c(between(0, l$equi99[1, 3], l$equi99[2, 3]),
between(0, l$equi95[1, 3], l$equi95[2, 3]),
between(0, l$equi90[1, 3], l$equi90[2, 3]))))
