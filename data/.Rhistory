library(tidyverse)
df = read_csv("historical_market_cap.csv")
df
library(lubridate)
df |>
mutate(date_q = floor_date(date, "quarter")) |>
rename(c(symbol = 'ticker')) |>
group_by(ticker, date_q) |>
summarisse(marketCap = mean(marketCap))
df |>
mutate(date_q = floor_date(date, "quarter")) |>
rename(c(symbol = 'ticker')) |>
group_by(ticker, date_q) |>
summarise(marketCap = mean(marketCap))
df |>
mutate(date_q = floor_date(date, "quarter")) |>
rename(c('ticker' = symbol)) |>
group_by(ticker, date_q) |>
summarise(marketCap = mean(marketCap))
df |>
mutate(date_q = ceiling_date(date, "quarter") - days(1)) |>
rename(c('ticker' = symbol)) |>
group_by(ticker, date_q) |>
summarise(marketCap = mean(marketCap))
