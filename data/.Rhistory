c(between(0, l$equi99[1, 3], l$equi99[2, 3]),
between(0, l$equi95[1, 3], l$equi95[2, 3]),
between(0, l$equi90[1, 3], l$equi90[2, 3]))))
EQUI3 <- do.call(rbind, lapply(Ber_s3, function(l)
c(between(0, l$equi99[1, 3], l$equi99[2, 3]),
between(0, l$equi95[1, 3], l$equi95[2, 3]),
between(0, l$equi90[1, 3], l$equi90[2, 3]))))
EQUI4 <- do.call(rbind, lapply(Ber_s4, function(l)
c(between(0.25, l$equi99[1, 3], l$equi99[2, 3]),
between(0.25, l$equi95[1, 3], l$equi95[2, 3]),
between(0.25, l$equi90[1, 3], l$equi90[2, 3]))))
EQUI <- rbind(apply(EQUI1, 2, mean),
