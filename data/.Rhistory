exp(MPLREML_log_mean_scenario1$Estimate) + MPLREML_sd_scenario1*qnorm(0.975)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario1$Estimate) - MPLREML_sd_scenario1*qnorm(0.95),
exp(MPLREML_log_mean_scenario1$Estimate) + MPLREML_sd_scenario1*qnorm(0.95)),
1, function(x) between(0.5, x[1], x[2])))
MPLREML_s1 <- apply(MPLREML_s1, 2, mean, na.rm = T)
#scenario2
MPLREML_s2 <- cbind(apply(cbind(exp(MPLREML_log_mean_scenario2$Estimate) - MPLREML_sd_scenario2*qnorm(0.995),
exp(MPLREML_log_mean_scenario2$Estimate) + MPLREML_sd_scenario2*qnorm(0.995)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario2$Estimate) - MPLREML_sd_scenario2*qnorm(0.975),
exp(MPLREML_log_mean_scenario2$Estimate) + MPLREML_sd_scenario2*qnorm(0.975)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario2$Estimate) - MPLREML_sd_scenario2*qnorm(0.95),
exp(MPLREML_log_mean_scenario2$Estimate) + MPLREML_sd_scenario2*qnorm(0.95)),
1, function(x) between(0.5, x[1], x[2])))
MPLREML_s2 <- apply(MPLREML_s2, 2, mean, na.rm = T)
#scenario3
MPLREML_s3 <- cbind(apply(cbind(exp(MPLREML_log_mean_scenario3$Estimate) - MPLREML_sd_scenario3*qnorm(0.995),
exp(MPLREML_log_mean_scenario3$Estimate) + MPLREML_sd_scenario3*qnorm(0.995)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario3$Estimate) - MPLREML_sd_scenario3*qnorm(0.975),
exp(MPLREML_log_mean_scenario3$Estimate) + MPLREML_sd_scenario3*qnorm(0.975)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario3$Estimate) - MPLREML_sd_scenario3*qnorm(0.95),
exp(MPLREML_log_mean_scenario3$Estimate) + MPLREML_sd_scenario3*qnorm(0.95)),
1, function(x) between(0.5, x[1], x[2])))
MPLREML_s3 <- apply(MPLREML_s3, 2, mean, na.rm = T)
#scenario4
MPLREML_s4 <- cbind(apply(cbind(exp(MPLREML_log_mean_scenario4$Estimate) - MPLREML_sd_scenario4*qnorm(0.995),
exp(MPLREML_log_mean_scenario4$Estimate) + MPLREML_sd_scenario4*qnorm(0.995)),
1, function(x) between(0.5, x[1], x[2])),
apply(cbind(exp(MPLREML_log_mean_scenario4$Estimate) - MPLREML_sd_scenario4*qnorm(0.975),
exp(MPLREML_log_mean_scenario4$Estimate) + MPLREML_sd_scenario4*qnorm(0.975)),
