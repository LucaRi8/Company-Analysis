# Aggiungi il titolo dell'asse X separatamente
x_axis_title <- text_grob("Scenari", size = 14, vjust = -0.5)
# Combina tutto con la legenda
final_plot <- plot_grid(
combined_plot,         # Grafici combinati
x_axis_title,          # Titolo dell'asse X
legend,                # Legenda
ncol = 1,              # Un'unica colonna
rel_heights = c(3, 0.2, 0.5)  # Altezza relativa: grafici, titolo X, legenda
)
# Aggiungi annotazioni per l'asse Y
annotate_figure(final_plot,
left = text_grob("Copertura", rot = 90, size = 14))
