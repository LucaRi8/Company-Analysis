# grafici degli intervalli
legend_plot <- tibble(Coperture = as.vector(INT99),
Metodo = rep(colnames(INT99), each=4),
Scenario = rep(1:4, 6)) |>
ggplot(aes(x = Scenario, y = Coperture, group = Metodo, color = Metodo)) +
geom_line() +
geom_point() +
theme(legend.position = "bottom") # Posizione legenda in basso
# Estrai la legenda
legend <- get_legend(legend_plot)
# Crea i tre grafici senza legenda
p1 <- tibble(Coperture = as.vector(INT99),
Metodo = rep(colnames(INT99), each=4),
Scenario = rep(1:4, 6)) |>
ggplot(aes(x = Scenario, y = Coperture, group = Metodo, color = Metodo)) +
geom_line() +
geom_point() +
theme(legend.position = "none",
axis.title.x = element_blank(),
axis.title.y = element_blank()) +
labs(title = "Copertura nominale al 99%")
p2 <- tibble(Coperture = as.vector(INT95),
